[Unit]
Description=Cornice digitale - pagina di gestione
After=network.target

[Service]
Type=simple
# install.sh sostituisce questo con l'utente che lancia lo script.
User=pi
WorkingDirectory=/opt/cornice
Environment=PYTHONPATH=/opt/cornice
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m web.app
Restart=always
RestartSec=3
# La pagina non deve mai rubare CPU allo slideshow.
Nice=10

[Install]
WantedBy=multi-user.target
